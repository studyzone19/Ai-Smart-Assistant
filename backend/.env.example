PORT=5000
NODE_ENV=development
MONGO_URI=mongodb+srv://<user>:<password>@<cluster-host>/<database>
# mongodb+srv://<user>:<password>@cluster0.mongodb.net/ai-smart-assistant
JWT_SECRET=replace_with_a_random_secret_of_at_least_32_characters
JWT_EXPIRES_IN=7d

# Google Gemini API key (used for chat, image analysis, PDF OCR, and image generation)
AI_API_KEY=your_google_ai_api_key
AI_MODEL=gemini-3.5-flash-lite

# Live web search is optional; the default request format is Tavily-compatible.
SEARCH_API_KEY=your_search_api_key
SEARCH_API_URL=https://api.tavily.com/search

CLIENT_URL=http://localhost:5173
TRUST_PROXY_HOPS=0
