PORT=5000
NODE_ENV=development
MONGO_URI=mongodb+srv://<user>:<password>@cluster0.mongodb.net/ai-smart-assistant
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d

# AI provider (Anthropic Claude - OpenAI-compatible logic is abstracted in services/aiService.js)
AI_API_KEY=your_anthropic_api_key
AI_MODEL=claude-sonnet-4-5

# Web search (optional - e.g. Serper, Tavily, Brave Search)
SEARCH_API_KEY=your_search_api_key
SEARCH_API_URL=https://api.tavily.com/search

CLIENT_URL=http://localhost:5173
